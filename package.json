{
  "name": "compProgrammingHelper",
  "displayName": "CPH: LeetCode Test Case Runner",
  "description": "Fetch LeetCode problem test cases and run them against your C++/Python solution directly from VS Code, with LinkedList/TreeNode support and a Run button in the editor.",
  "version": "0.1.2",
  "publisher": "AdityaKumar",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "leetcode",
    "competitive programming",
    "coding interview",
    "test cases",
    "algorithms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/moodyadi2006/CPH.git"
  },
  "bugs": {
    "url": "https://github.com/moodyadi2006/CPH/issues"
  },
  "homepage": "https://github.com/moodyadi2006/CPH#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Education",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onCommand:competitive-programming-helper.runTestCases",
    "onCommand:competitive-programming-helper.openTestCasesWebview",
    "onView:testCasesExplorer",
    "onLanguage:cpp",
    "onLanguage:python"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "competitive-programming-helper",
          "title": "Competitive Programming Helper",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "testCasesExplorer",
          "name": "Test Cases Explorer",
          "when": "view == explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "competitive-programming-helper.runTestCases",
        "title": "CPH: Run Test Cases"
      },
      {
        "command": "competitive-programming-helper.openTestCasesWebview",
        "title": "CPH: Open LeetCode Test Cases Webview"
      }
    ],
    "configuration": {
      "title": "Competitive Programming Helper",
      "properties": {
        "competitiveProgrammingHelper.executionTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 500,
          "description": "Maximum time (ms) a compiled/interpreted solution may run before being killed as timed out."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0"
  },
  "dependencies": {
    "axios": "^1.7.9"
  }
}
